# CHARISFERME - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ===== STRIPE PAYMENT =====
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX

# ===== EMAIL CONFIGURATION =====
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXX
SENDGRID_FROM_EMAIL=noreply@charisferme.fr
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASS=${SENDGRID_API_KEY}
SMTP_PORT=587

# ===== GOOGLE ANALYTICS =====
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXXXX

# ===== DATABASE (si nécessaire) =====
# DATABASE_URL=postgresql://user:password@localhost:5432/charisferme

# ===== NETLIFY CONFIGURATION =====
